      },
      "kind": {
        "$ref": "#/$defs/ObjectKind",
        "description": "Object kind"
      },
      "limit": {
        "default": 50,
        "description": "Maximum number of items to return",
        "maximum": 500,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      },
      "name": {
        "description": "Object name",
        "title": "Name",
        "type": "string"
      },
      "offset": {
        "default": 0,
        "description": "Number of items to skip",
        "minimum": 0,
        "title": "Offset",
        "type": "integer"
      },
      "scope": {
        "default": "shared",
        "description": "Scope where the object is defined",
        "title": "Scope",
        "type": "string"
      }
    },
    "required": [
      "name",
      "kind"
    ],
    "title": "find_object_referencesArguments",
    "type": "object"
  },
