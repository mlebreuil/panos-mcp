  "find_object_references": {
    "$defs": {
      "ConfigSource": {
        "enum": [
          "running",
          "candidate"
        ],
        "title": "ConfigSource",
        "type": "string"
      },
      "ObjectKind": {
        "enum": [
          "address",
          "address_group",
          "service",
          "service_group",
          "application_group",
          "tag",
          "security_profile_group"
        ],
        "title": "ObjectKind",
        "type": "string"
      }
    },
    "properties": {
